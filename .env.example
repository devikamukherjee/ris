# Permit Guardian configuration. `make setup` copies this to .env.
# Write values without quotes (the Makefile exports them as-is).

# The only host the app is allowed to contact. Keep it on loopback.
OLLAMA_HOST=http://localhost:11434

# Any installed 7-8B instruct model works. Check with: ollama list
OLLAMA_MODEL=qwen2.5:7b-instruct

# SQLite file, relative to the repo root.
PG_DB_PATH=data/permit_guardian.db
